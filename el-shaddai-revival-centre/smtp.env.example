# =============================================================================
# How this works (three team inboxes, one SMTP sender)
# =============================================================================
# You only configure ONE Gmail account for SMTP (SMTP_USER + SMTP_PASS). That
# account connects to smtp.gmail.com and sends every automated email.
#
# The three addresses below are WHO RECEIVES each kind of notification (To/Bcc).
# They can be three different Gmail addresses; the server still logs in once.
#
# Requirements on Gmail:
# - Either all three are aliases / "Google Workspace users" your SMTP account
#   may send *to* (normal case), or
# - SMTP_USER is one mailbox and you only send *to* the other two (always OK).
#
# If EMAIL_FROM is the same mailbox as SMTP_USER, avoid expecting a separate
# "inbox copy" to that same address for messages the app also sends To that
# address (Gmail quirk). The contact API already works around that for info@.
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=your-sending-account@gmail.com
EMAIL_FROM_NAME=El-Shaddai Revival Centre

# Who receives which notifications (defaults match your current site copy)
CONTACT_INFO_EMAIL=info.copelshaddai@gmail.com
CONTACT_PRAYER_EMAIL=prayerrequest.copelshaddai@gmail.com
CONTACT_PAYMENTS_EMAIL=payment.copelshaddai@gmail.com

# "Unexpected socket close" with Gmail: try SMTP_PORT=465 (TLS from connect; code sets
# secure automatically). Defaults also force IPv4 and longer timeouts; disable IPv4-only
# with SMTP_IPV4_ONLY=false if your network requires IPv6.
#
# Optional timeouts (ms): SMTP_CONNECTION_TIMEOUT_MS, SMTP_GREETING_TIMEOUT_MS, SMTP_SOCKET_TIMEOUT_MS
