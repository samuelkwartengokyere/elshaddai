# Copy these into .env.local (never commit real keys).
# Dashboard: https://dashboard.paystack.com/#/settings/developer

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Give page only offers GHS + USD. Optionally restrict to one if Paystack only activates a single currency:
# NEXT_PUBLIC_PAYSTACK_ALLOWED_CURRENCIES=GHS
# NEXT_PUBLIC_PAYSTACK_DEFAULT_CURRENCY=GHS

# Ghana Paystack accounts often cannot charge USD. Set this to always settle in GHS when donor picks USD
# (conversion uses app rates in src/lib/currency.ts):
# PAYSTACK_SETTLEMENT_CURRENCY=GHS
#
# If unset, the API still retries USD once and falls back to GHS when Paystack returns "Currency not supported".
# To disable that auto-fallback: PAYSTACK_DISABLE_USD_TO_GHS_FALLBACK=1

# Public site URL (no trailing slash). Used so Paystack can redirect donors back to /give after hosted checkout.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional override for transaction initialize callback_url
# PAYSTACK_CALLBACK_URL=https://your-domain.com/give

# Set to 1 to stop sending Paystack `channels` (shows every enabled instrument instead of the one chosen on Give):
# PAYSTACK_DISABLE_METHOD_CHANNELS=1
